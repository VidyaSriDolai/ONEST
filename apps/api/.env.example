# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Local dev uses SQLite so the project runs with no external services.
# For PostgreSQL: switch the provider in prisma/schema.prisma and use e.g.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillseal?schema=public"
DATABASE_URL="file:./dev.db"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-0000000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-000000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Client ----
WEB_APP_URL=http://localhost:5173

# ---- Certificate signing (Ed25519) ----
# Certificates are signed so they are tamper-evident: altering any field on an
# issued certificate invalidates its signature and the verify endpoint reports
# TAMPERED rather than VALID.
#
# THE KEYPAIR BELOW IS A THROWAWAY DEVELOPMENT KEY AND IS PUBLIC. Generate a
# fresh one before any real deployment:
#   node -e "const c=require('crypto');const{publicKey:a,privateKey:b}=c.generateKeyPairSync('ed25519');console.log(b.export({type:'pkcs8',format:'pem'}).toString().replace(/\n/g,'\\n'));console.log(a.export({type:'spki',format:'pem'}).toString().replace(/\n/g,'\\n'))"
# Newlines are written as \n and expanded when the value is read.
CERT_SIGNING_KEY_ID=dev-2026-01
CERT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIOWEXwXwQqNHfeQ7B9/r36m8P7XyCHQZmdEYLDbQxlwJ\n-----END PRIVATE KEY-----"
CERT_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAYQyYva46s3kybIRuJBHzLglQgCEqtjgxEy9vJYF8IX4=\n-----END PUBLIC KEY-----"
